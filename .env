# Образ на Docker Hub
RMS_IMAGE=shchegolastratime/rms-assembly:0.1.1

# Обязательные
# Адрес WMS c /api
RMS_WMS__BASE_URL=http://host.docker.internal:8180/api           # При запуске эмулятора в контейнере
# Адрес DarkstoreDB
RMS_DARKSTORE_DB_URL__BASE_URL=http://host.docker.internal:8580  # При запуске эмулятора в контейнере
# Номер торговой точки
RMS_WMS__STORE_ID=999 # Эмулятор DarkstoreDB по умолчанию ожидает это значение
# Токен авторизации WMS
RMS_WMS_TOKEN=secret-token

# Необязательные
# RMS_HTTP_HOST_PORT=8080
# POSTGRES_PASSWORD=rms
