# Образ на Docker Hub
RMS_IMAGE=shchegolastratime/rms-assembly:0.1.5

# Обязательные
# Адрес WMS c /api
RMS_WMS__BASE_URL=http://localhost:8180/api           # При запуске эмулятора в контейнере
# Адрес DarkstoreDB
RMS_DARKSTORE_DB_URL__BASE_URL=http://localhost:8580  # При запуске эмулятора в контейнере
# Токен для DarkstoreDB
RMS_DARKSTORE_DB_TOKEN=secret-token
# Номер торговой точки
RMS_WMS__STORE_ID=999 # Эмулятор DarkstoreDB по умолчанию ожидает это значение
# Токен авторизации WMS
RMS_WMS_TOKEN=secret-token

# Необязательные
# RMS_HTTP_HOST_PORT=8080

# PostgreSQL: порт контейнера на хосте и адрес подключения RMS
RMS_POSTGRES_HOST_PORT=55432
RMS_DB_DSN=postgresql://rms:rms@localhost:${RMS_POSTGRES_HOST_PORT}/rms
